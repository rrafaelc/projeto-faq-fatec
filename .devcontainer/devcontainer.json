{
  "name": "FAQ Fatec",
  "dockerComposeFile": "docker-compose.yml",
  "service": "php",
  "workspaceFolder": "/var/www/projeto-faq-fatec",
  "forwardPorts": [80, 3306],
  "portsAttributes": {
    "80": { "label": "Apache", "onAutoForward": "notify" },
    "3306": { "label": "MySQL", "onAutoForward": "silent" }
  },
  "postCreateCommand": "cd api && cp -n .env.example .env && composer install",
  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "xdebug.php-debug",
        "onecentlin.phpunit-snippets",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
